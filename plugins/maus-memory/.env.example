# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Postgres password and the token OpenMausBot sends with every call (32+ random characters: openssl rand -hex 32).
MAUS_DB_PASSWORD=
MAUS_MEMORY_TOKEN=

# Embeddings for search by meaning: none | ollama | openai (any OpenAI-compatible /v1/embeddings).
# With Ollama: docker compose --profile ollama up -d, then: docker compose exec ollama ollama pull bge-m3
MAUS_EMBEDDINGS=none
MAUS_EMBEDDINGS_URL=http://ollama:11434
MAUS_EMBEDDINGS_MODEL=bge-m3
MAUS_EMBEDDINGS_KEY=

# The model the dream uses: none | anthropic (Messages API, or a provider's Anthropic-compatible URL)
# | openai (any OpenAI-compatible chat/completions URL, Ollama included: http://ollama:11434/v1)
# | claude-cli (your Claude subscription; only when the service runs on the host with `npm start`, not in Docker).
MAUS_LLM=none
MAUS_LLM_URL=
MAUS_LLM_MODEL=
MAUS_LLM_KEY=

# A bot dreams once its chats have been quiet this long (ms).
MAUS_DREAM_QUIET_MS=600000

# Ports on 127.0.0.1 of this machine.
MAUS_PORT=8787
MAUS_DB_PORT=5433
